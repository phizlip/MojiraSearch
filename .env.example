# embedding
EMBEDDING_BATCH_SIZE=64    # how many issues are embedded at once
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_THREADS=2       # cpu threads allocated to pytorch
# EMBEDDING_DEVICE=cpu  # detects mps > cuda > cpu

# fetching
FETCH_RPS=3.0             # max requests per second to mojira.dev
JQL_FETCH_RPS=3.0       # bugs.mojang.com JQL calls
FETCH_CONCURRENCY=4
PROJECTS=MC,MCPE,REALMS,BDS,MCL,WEB

# storage
DATA_DIR=./data

# qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=mojira

# api
API_PORT=8000
