# embedding
EMBEDDING_BATCH_SIZE=4    # how many issues are embedded at once
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_THREADS=2       # cpu threads allocated to pytorch

# fetching
FETCH_RPS=5.0             # max requests per second to mojira.dev
FETCH_CONCURRENCY=5       # max simultaneous requests
PROJECTS=MC,MCPE,REALMS,BDS,MCL,WEB

# storage
DATA_DIR=./data

# qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=mojira

# api
API_PORT=8000
